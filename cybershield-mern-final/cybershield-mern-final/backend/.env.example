# CyberShield Intelligence Platform — Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=5000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cybershield
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cybershield_secret_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=cybershield_super_secret_jwt_key_2026_soc_prod
JWT_EXPIRES_IN=24h

# CORS (comma-separated origins or * for all)
CORS_ORIGIN=http://localhost:5173
