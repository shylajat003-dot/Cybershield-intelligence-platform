# CyberShield Intelligence Platform — Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=5000

# MongoDB Database Configuration
# Option A: MongoDB Atlas Cloud (Recommended)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cybershield?retryWrites=true&w=majority&appName=CyberShield

# Option B: Local MongoDB (Docker or Local Service)
# MONGODB_URI=mongodb://localhost:27017/cybershield

# JWT Authentication
JWT_SECRET=cybershield_super_secret_jwt_key_2026_soc_prod
JWT_EXPIRES_IN=24h

# CORS (Frontend client URL)
CORS_ORIGIN=http://localhost:5173


